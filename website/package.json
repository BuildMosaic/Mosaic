{
  "name": "buildmosaic-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "python3 ../compatibility/automation.py validate && pnpm prepare:assets",
    "prebuild": "python3 ../compatibility/automation.py validate && pnpm prepare:assets",
    "build": "astro build --force",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:links": "node scripts/check-links.mjs",
    "api": "cd .. && ./gradlew dokkaGeneratePublicationHtml && cd website && node scripts/prepare-assets.mjs --api",
    "qa": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.5",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "astro": "7.3.5",
    "astro-expressive-code": "0.44.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "cheerio": "1.2.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3"
  }
}
